# Voho — the speaking half. Create a token at https://app.voho.ai (API Tokens).
VOHO_API_KEY=voho_sk_live_xxxxxxxxxxxxxxxxxxxxxxxx
VOHO_WS_URL=wss://app.voho.ai/v1/speech/ws
# Najdi voices: layla, nouf, faisal, omar. See https://docs.voho.ai/voices
VOHO_VOICE=layla
# sada-1 is the faster model and the right default for a live call.
VOHO_MODEL=sada-1

# The language model that writes the answer. Optional — with no key the agent
# reads the retrieved passage back, which is enough to test the pipeline.
# OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Your documents. Any directory of .md files, split on ## headings.
KNOWLEDGE_DIR=knowledge
